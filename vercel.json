{
  "version": 2,
  "cleanUrls": true,
  "redirects": [
    { "source": "/", "destination": "/web/demo/index.html", "permanent": false }
  ],
  "rewrites": [
    { "source": "/LoginController", "destination": "/web/demo/index.html" },
    { "source": "/LockerMapController", "destination": "/web/demo/map.html" },
    { "source": "/DashboardController", "destination": "/web/demo/dashboard.html" },
    { "source": "/UserController", "destination": "/web/demo/users.html" },
    { "source": "/RoleController", "destination": "/web/demo/roles.html" },
    { "source": "/AuditController", "destination": "/web/demo/logs.html" },
    { "source": "/css/(.*)", "destination": "/web/css/$1" },
    { "source": "/js/(.*)", "destination": "/web/js/$1" },
    { "source": "/demo/(.*)", "destination": "/web/demo/$1" },
    { "source": "/(map|dashboard|users|roles|logs|areas|role-perm|user-form)", "destination": "/web/demo/$1.html" }
  ]
}
